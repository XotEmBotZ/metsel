Screen {
    layout: vertical;
    padding: 0;
    height: 100vh;
}

#app-box {
    height: 1fr;
    layout: vertical;
    padding: 0;
}

Footer {
    height: 1;
    dock: bottom;
}

#top-bar {
    height: 1;
    padding: 0 1;
    layout: horizontal;
    align-vertical: middle;
    outline: round $accent;
    margin-bottom: 0;
}

#file-info-header {
    width: 1fr;
    height: 1;
    content-align: left middle;
}

#content-container {
    height: 1fr;
    layout: horizontal;
    padding: 0;
}

#variables-pane {
    width: 60%;
    height: 100%;
    padding: 0 1;
    layout: vertical;
    outline: round $accent;
    margin-right: 0;
}

#filter-input {
    margin-top: 0;
    margin-bottom: 1;
}

/* Table Header for Variable Selector */
#table-header {
    height: 1;
    color: $text;
    text-style: bold;
    padding: 0;
}

#table-header .col-chk { width: 6; }
#table-header .col-shortname { width: 13; }
#table-header .col-name { width: 33; }
#table-header .col-level { width: 13; }
#table-header .col-leveltype { width: 17; }
#table-header .col-time { width: 9; }

#var-optionlist {
    height: 1fr;
    padding: 0;
    background: transparent;
    border: none;
}

OptionList > .option-list--option-highlighted {
    text-style: bold;
    background: transparent;
}

.row-container {
    height: 1;
    align-vertical: middle;
    padding: 0;
    background: transparent;
}

.row-checkbox {
    width: 5;
    min-height: 1;
    height: 1;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
}

.row-checkbox:focus {
    background: transparent;
}

.row-checkbox > .toggle--button {
    background: transparent;
}

.row-checkbox > .toggle--label {
    display: none;
}

.col-msg { width: 6; text-style: bold; color: $accent; }
.col-shortname { width: 10; color: $success; text-style: bold; }
.col-name { width: 1fr; }
.col-level { width: 10; color: $warning; }
.col-leveltype { width: 16; color: $text-muted; }
.col-time { width: 10; color: $accent; }

#inspector-pane {
    width: 40%;
    height: 100%;
    padding: 0 1;
    layout: vertical;
    outline: round $accent;
}

.pane-header {
    text-style: bold;
    color: $accent;
    margin-top: 0;
    margin-bottom: 0;
}



.button-bar-small {
    height: 3;
    margin-top: 0;
    margin-bottom: 0;
}

.button-bar-small Button {
    margin-right: 1;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    height: 1fr;
    padding: 0;
}

#tab-levels-selector {
    height: 1fr;
    layout: vertical;
    overflow-y: hidden;
}

#level-optionlist {
    height: 1fr;
    min-height: 5;
    outline: round $accent;
    background: transparent;
    overflow-y: auto;
}

.selection-summary {
    margin-top: 1;
    margin-bottom: 1;
    text-style: bold;
    color: $warning;
}

/* Modal CSS */
FileOpenModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}

#dialog {
    width: 75;
    height: auto;
    border: round $accent;
    background: $panel;
    padding: 1 2;
}

#modal-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#file-input {
    margin-bottom: 1;
}

.meta-line {
    margin-bottom: 0;
    color: $text-muted;
}

#file-results-list {
    height: 6;
    margin-bottom: 1;
    border: solid $primary;
}

.button-bar {
    align-horizontal: right;
    height: auto;
    margin-top: 1;
}

Button {
    margin-left: 1;
}
